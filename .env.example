NODE_ENV=development
APP_NAME=WorkHub
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://workhub:workhub_local_password@localhost:5432/workhub?schema=public
REDIS_URL=redis://localhost:6379

# Local S3-compatible storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=workhub-local
STORAGE_ACCESS_KEY=workhub_local
STORAGE_SECRET_KEY=change_me_local_only
STORAGE_FORCE_PATH_STYLE=true

# Generate strong random values for local use; never reuse in production.
JWT_ACCESS_SECRET=replace_with_long_random_local_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_local_secret

# Email providers are configured per mailbox through secure OAuth/provider setup.
# Do not place employee mailbox credentials in this shared environment file.
