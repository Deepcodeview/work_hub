{
  "expo": {
    "name": "WorkHub",
    "slug": "workhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFAF5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workhub.mobile"
    },
    "android": {
      "package": "com.workhub.mobile",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFAF5"
      }
    },
    "extra": {
      "eas": {
        "projectId": "workhub-mobile"
      }
    }
  }
}
