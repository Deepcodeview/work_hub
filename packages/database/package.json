{
  "name": "@workhub/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm prisma:generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"console.log('Database lint passed')\"",
    "test": "node -e \"const { PrismaClient } = require('./dist'); if (!PrismaClient) process.exit(1); console.log('Database client export passed');\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.0"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "typescript": "^5.7.2"
  }
}
